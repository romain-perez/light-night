  "semanticTokenColors": {
    "variable": "#fcf8ec",
    "parameter": {
      "foreground": "#9cdcfe",
      "italic": true
    },
    "recordComponent": {
      "foreground": "#9cdcfe",
      "italic": true
    },
    "property": "#f07178",
    "method": "#ffb454",
    "function": "#ffb454",
    "class": "#4ec9b0",
    "record": "#4ec9b0",
    "type": "#4ec9b0",
    "enum": "#4ec9b0",
    "typeParameter": "#4ec9b0",
    "interface": {
      "foreground": "#4ec9b0",
      "italic": true
    },
    "annotation": "#4ec9b0",
    "enumMember": {
      "foreground": "#f29668",
      "bold": true
    },
    "property.static.readonly": {
      "foreground": "#f29668",
      "bold": true
    },
    "namespace": "#b2ccd6"
  },
  "tokenColors": [
    {
      "name": "Global settings",
      "settings": {
        "background": "#242936",
        "foreground": "#fcf8ec"
      }
    },
    {
      "name": "Comment",
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#7f8a9e",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Comment TODO",
      "scope": "comment.todo",
      "settings": {
        "foreground": "#FFD54F",
        "fontStyle": "bold"
      }
    },
    {
      "name": "String",
      "scope": [
        "string",
        "string.quoted",
        "punctuation.definition.string",
        "punctuation.definition.string.begin",
        "punctuation.definition.string.end",
        "punctuation.definition.string.template"
      ],
      "settings": {
        "foreground": "#c3e88d"
      }
    },
    {
      "name": "Escape (\\n, \\t)",
      "scope": [
        "constant.character.escape"
      ],
      "settings": {
        "foreground": "#d7ba7d"
      }
    },
    {
      "name": "RegExp",
      "scope": [
        "string.regexp",
        "string.regexp keyword.other"
      ],
      "settings": {
        "foreground": "#95e6cb"
      }
    },
    {
      "name": "Number",
      "scope": [
        "constant.numeric",
        "constant.character.numeric",
        "keyword.other.unit"
      ],
      "settings": {
        "foreground": "#b5cea8"
      }
    },
    {
      "name": "Built-in constant (null, true, false)",
      "scope": [
        "constant.language",
        "constant.language.null",
        "constant.language.boolean"
      ],
      "settings": {
        "foreground": "#4fc1ff"
      }
    },
    {
      "name": "Constant (MAX_SIZE, enum value)",
      "scope": [
        "variable.other.constant",
        "variable.other.enummember",
        "constant.other.enum"
      ],
      "settings": {
        "foreground": "#f29668",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Variable",
      "scope": [
        "variable",
        "meta.definition.variable.name",
        "support.variable",
        "variable.other.readwrite",
        "variable.other.object"
      ],
      "settings": {
        "foreground": "#fcf8ec"
      }
    },
    {
      "name": "Parameter",
      "scope": [
        "variable.parameter"
      ],
      "settings": {
        "foreground": "#9cdcfe",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Attribute / field",
      "scope": [
        "variable.other.property",
        "variable.other.object.property",
        "meta.object-literal.key"
      ],
      "settings": {
        "foreground": "#f07178"
      }
    },
    {
      "name": "Language variable (this, super)",
      "scope": [
        "variable.language"
      ],
      "settings": {
        "foreground": "#4fc1ff",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Keyword (structure : instanceof, extends...)",
      "scope": [
        "keyword",
        "keyword.operator.new",
        "keyword.operator.expression",
        "keyword.operator.instanceof",
        "keyword.operator.cast"
      ],
      "settings": {
        "foreground": "#4fc1ff"
      }
    },
    {
      "name": "Control keyword (if, return, new, throw...)",
      "scope": [
        "keyword.control",
        "keyword.control.new",
        "keyword.other.using",
        "keyword.other.operator"
      ],
      "settings": {
        "foreground": "#da70d6",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Import / export (JS, TS) en gras",
      "scope": [
        "keyword.control.import",
        "keyword.control.export"
      ],
      "settings": {
        "foreground": "#da70d6",
        "fontStyle": "italic bold"
      }
    },
    {
      "name": "Storage (const, let, function, var)",
      "scope": [
        "storage",
        "storage.type"
      ],
      "settings": {
        "foreground": "#4fc1ff"
      }
    },
    {
      "name": "Storage Modifier (public, private, static, final, class...)",
      "scope": [
        "storage.modifier"
      ],
      "settings": {
        "foreground": "#4fc1ff",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Import / package (neutre comme chez VS Code)",
      "scope": [
        "storage.modifier.import.java",
        "storage.modifier.package.java",
        "variable.language.wildcard.java"
      ],
      "settings": {
        "foreground": "#bfc7d5",
        "fontStyle": ""
      }
    },
    {
      "name": "Types (classes, interfaces, primitifs, génériques)",
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "entity.name.type.class",
        "entity.other.inherited-class",
        "support.type",
        "support.class",
        "storage.type.java",
        "storage.type.generic.java",
        "storage.type.object.array.java",
        "storage.type.primitive.java",
        "storage.type.primitive.array.java",
        "storage.type.token.java",
        "meta.type.cast.expr",
        "meta.type.new.expr"
      ],
      "settings": {
        "foreground": "#4ec9b0"
      }
    },
    {
      "name": "Annotation (@Configuration, @Override)",
      "scope": [
        "storage.type.annotation",
        "storage.type.annotation.java",
        "punctuation.definition.annotation",
        "meta.declaration.annotation"
      ],
      "settings": {
        "foreground": "#4ec9b0"
      }
    },
    {
      "name": "Namespace / package name",
      "scope": [
        "entity.name.namespace",
        "entity.name.package",
        "storage.modifier.package",
        "storage.modifier.import"
      ],
      "settings": {
        "foreground": "#b2ccd6"
      }
    },
    {
      "name": "Function / method",
      "scope": [
        "entity.name.function",
        "support.function",
        "variable.function",
        "meta.function-call entity.name.function"
      ],
      "settings": {
        "foreground": "#ffb454"
      }
    },
    {
      "name": "Operators",
      "scope": [
        "keyword.operator",
        "keyword.operator.relational",
        "keyword.operator.assignment",
        "keyword.operator.logical",
        "keyword.operator.comparison",
        "keyword.operator.arithmetic"
      ],
      "settings": {
        "foreground": "#bfc7d5"
      }
    },
    {
      "name": "Punctuation",
      "scope": [
        "punctuation",
        "punctuation.accessor",
        "punctuation.terminator",
        "punctuation.separator",
        "meta.brace",
        "punctuation.definition.arguments",
        "punctuation.section"
      ],
      "settings": {
        "foreground": "#bfc7d5"
      }
    },
    {
      "name": "HTML / JSX tag names",
      "scope": [
        "entity.name.tag",
        "meta.tag.html"
      ],
      "settings": {
        "foreground": "#4fc1ff"
      }
    },
    {
      "name": "Tag punctuation",
      "scope": [
        "punctuation.definition.tag"
      ],
      "settings": {
        "foreground": "#7f8a9e"
      }
    },
    {
      "name": "Tag attribute / JSX prop",
      "scope": [
        "entity.other.attribute-name"
      ],
      "settings": {
        "foreground": "#9cdcfe",
        "fontStyle": "italic"
      }
    },
    {
      "name": "CSS property names",
      "scope": [
        "support.type.vendored.property-name",
        "support.type.property-name",
        "meta.property-name"
      ],
      "settings": {
        "foreground": "#9cdcfe"
      }
    },
    {
      "name": "CSS selectors",
      "scope": [
        "entity.name.tag.css",
        "entity.name.tag.less",
        "entity.other.attribute-name.class.css",
        "entity.other.attribute-name.id.css",
        "meta.selector"
      ],
      "settings": {
        "foreground": "#ffb454"
      }
    },
    {
      "name": "CSS values",
      "scope": [
        "support.constant.property-value",
        "support.constant.color",
        "constant.other.color.rgb-value"
      ],
      "settings": {
        "foreground": "#f29668"
      }
    },
    {
      "name": "JSON / YAML keys",
      "scope": [
        "support.type.property-name.json",
        "entity.name.tag.yaml"
      ],
      "settings": {
        "foreground": "#9cdcfe",
        "fontStyle": ""
      }
    },
    {
      "name": "Markdown heading",
      "scope": [
        "markup.heading",
        "markup.heading entity.name"
      ],
      "settings": {
        "foreground": "#4fc1ff",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Markdown italic",
      "scope": [
        "markup.italic"
      ],
      "settings": {
        "foreground": "#da70d6",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Markdown bold",
      "scope": [
        "markup.bold"
      ],
      "settings": {
        "foreground": "#ffb454",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Markdown code",
      "scope": [
        "markup.inline.raw",
        "markup.fenced_code",
        "markup.raw"
      ],
      "settings": {
        "foreground": "#f29668"
      }
    },
    {
      "name": "Markdown quote",
      "scope": [
        "markup.quote"
      ],
      "settings": {
        "foreground": "#7f8a9e",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Markdown link",
      "scope": [
        "markup.underline.link",
        "markup.underline.link.image",
        "string.other.link"
      ],
      "settings": {
        "foreground": "#9cdcfe"
      }
    },
    {
      "name": "Diff inserted",
      "scope": [
        "markup.inserted"
      ],
      "settings": {
        "foreground": "#c3e88d"
      }
    },
    {
      "name": "Diff deleted",
      "scope": [
        "markup.deleted"
      ],
      "settings": {
        "foreground": "#f07178"
      }
    },
    {
      "name": "Diff changed",
      "scope": [
        "markup.changed"
      ],
      "settings": {
        "foreground": "#4fc1ff"
      }
    },
    {
      "name": "Invalid",
      "scope": [
        "invalid"
      ],
      "settings": {
        "foreground": "#d95757"
      }
    },
    {
      "name": "Shell : commandes (mysql, echo, cd)",
      "scope": [
        "entity.name.command.shell",
        "support.function.builtin.shell",
        "entity.name.function.call.shell"
      ],
      "settings": {
        "foreground": "#ffb454",
        "fontStyle": ""
      }
    },
    {
      "name": "Shell : options et tests (-e, --force, -d, -eq)",
      "scope": [
        "constant.other.option.shell",
        "constant.other.option.dash.shell",
        "source.shell constant.other.option",
        "keyword.operator.logical.shell"
      ],
      "settings": {
        "foreground": "#4fc1ff",
        "fontStyle": ""
      }
    },
    {
      "name": "Shell : nom à l'affectation (MAX=5)",
      "scope": [
        "variable.other.assignment.shell",
        "variable.other.loop.shell",
        "variable.other.for.shell"
      ],
      "settings": {
        "foreground": "#fcf8ec",
        "fontStyle": ""
      }
    },
    {
      "name": "Shell : lecture de variable ($HOME, ${HOME})",
      "scope": [
        "variable.other.normal.shell",
        "variable.other.bracket.shell",
        "punctuation.definition.variable.shell",
        "punctuation.section.bracket.curly.variable.begin.shell",
        "punctuation.section.bracket.curly.variable.end.shell"
      ],
      "settings": {
        "foreground": "#9cdcfe",
        "fontStyle": ""
      }
    },
    {
      "name": "Shell : paramètres du script ($1, $@)",
      "scope": [
        "variable.parameter.positional.shell",
        "variable.parameter.positional.all.shell",
        "variable.language.special.at.shell"
      ],
      "settings": {
        "foreground": "#9cdcfe",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Shell : variables spéciales ($?, $$, $#)",
      "scope": [
        "variable.language.special.shell"
      ],
      "settings": {
        "foreground": "#4fc1ff",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Shell : enchaînements (|, &&, ||, <, >)",
      "scope": [
        "keyword.operator.pipe.shell",
        "keyword.operator.redirect.shell",
        "keyword.operator.redirect.stdout.shell",
        "keyword.operator.redirect.stderr.shell",
        "keyword.operator.heredoc.shell",
        "keyword.operator.herestring.shell",
        "punctuation.separator.statement.and.shell",
        "punctuation.separator.statement.or.shell",
        "punctuation.separator.statement.background.shell"
      ],
      "settings": {
        "foreground": "#da70d6",
        "fontStyle": ""
